{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "lib": ["ES2019", "DOM"],
    "outDir": "./dist",
    "rootDir": "../",
    "declaration": false,
    "declarationMap": false,
    "baseUrl": "..",
    "paths": {
      "@client/*": ["client/src/*"],
      "@shared/*": ["shared/src/*"]
    },
    "moduleResolution": "node"
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "dist"]
}
