{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2019",
    "module": "CommonJS",
    "lib": ["ES2019"],
    "outDir": "../dist/server",
    "rootDir": "../",
    "declaration": true,
    "moduleResolution": "node",
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["shared/src/*"]
    }
  },
  "include": ["./src/**/*", "../shared/src/**/*"],
  "exclude": ["node_modules", "dist", "../dist"]
}
